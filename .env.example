# App
DATABASE_URL="postgresql://blend:blend@localhost:5432/gsc_ga4_blend?schema=public"
AUTH_SECRET="generate-with-openssl-rand-base64-32"
AUTH_URL="http://localhost:3000"

# Google OAuth (Desktop or Web client — redirect URI: http://localhost:3000/api/auth/callback/google)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

DEMO_MODE="false"
USE_OFFLINE_DB="true"
# Exposed to Edge middleware (auth bypass for offline SQLite mode)
NEXT_PUBLIC_USE_OFFLINE_DB="true"
# Absolute path to Python exporter SQLite (or relative to web/)
OFFLINE_DB_PATH="../data/gsc_offline.db"
