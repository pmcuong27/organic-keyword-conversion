# App
# npm run db:up starts Docker Postgres on 5432, or local Prisma Postgres on 51214 if Docker is unavailable.
DATABASE_URL="postgresql://blend:blend@localhost:5432/gsc_ga4_blend?schema=public"
AUTH_SECRET="generate-with-openssl-rand-base64-32"
AUTH_URL="http://localhost:3000"

# Google OAuth Web client
# Authorized redirect URI: {AUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# true = sample data, no Google login or Postgres required
DEMO_MODE="true"

# Optional local-only SQLite from the Python exporters (not for public deploys)
USE_OFFLINE_DB="false"
# OFFLINE_DB_PATH="../data/gsc_offline.db"
